{
  "name": "@meri-imperiumi/signalk-energy-predictor",
  "version": "0.1.0",
  "description": "Predictive energy management plugin for Signal K using offline-first incremental learning",
  "main": "plugin/index.js",
  "scripts": {
    "format": "npx @biomejs/biome check --use-editorconfig=true --write plugin/ tests/ bin/ public/",
    "lint": "npx @biomejs/biome check --use-editorconfig=true plugin/ public/",
    "test": "node --test --test-force-exit \"tests/*.test.js\"",
    "backtest": "node bin/backtest.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/meri-imperiumi/signalk-energy-predictor.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "signalk-webapp"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/meri-imperiumi/signalk-energy-predictor/issues"
  },
  "homepage": "https://github.com/meri-imperiumi/signalk-energy-predictor#readme",
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "Energy Predictor",
    "appIcon": "./icon.png",
    "screenshots": [
      "./doc/webapp-day.png",
      "./doc/webapp-month.png"
    ],
    "requires": [
      "@meri-imperiumi/signalk-autostate"
    ],
    "recommends": [
      "signalk-venus-plugin",
      "@meri-imperiumi/signalk-logbook"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.30.0"
  }
}
